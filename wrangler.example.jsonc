{
  "name": "coconutrate",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-27",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },

  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "your-email@example.com"
    }
  ]
}